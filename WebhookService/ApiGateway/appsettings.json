{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "webhooks-route": {
        "ClusterId": "webhook-cluster",
        "Match": { "Path": "/api/webhooks/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "d1": { "Address": "http://auth-service:8080/" } }
      },
      "payment-cluster": {
        "Destinations": { "d1": { "Address": "http://payment-service:8080/" } }
      },
      "webhook-cluster": {
        "Destinations": { "d1": { "Address": "http://webhook-service:8080/" } }
      },
      "inventory-cluster": {
        "Destinations": { "d1": { "Address": "http://inventory-service:8080/" } }
      }
    }
  }
}
